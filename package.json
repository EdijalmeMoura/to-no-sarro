{
  "name": "to-no-sarro-smart-food-system",
  "private": true,
  "version": "0.2.0",
  "description": "TÔ NO SARRO! — Smart Food System: cardápio digital, gestão de pedidos, KDS, expedição e app do entregador.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.js",
    "dev:all": "concurrently -k -n api,web -c yellow,orange \"npm:dev:server\" \"npm:dev\"",
    "seed": "node server/db.js --reset",
    "build": "vite build",
    "start": "node server/index.js",
    "check:paineis": "npm run build && node scripts/empacotar-app.mjs && node scripts/verificar-paineis.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.12",
    "jsdom": "^30.1.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0"
  },
  "engines": {
    "node": ">=22.13.0 <25"
  }
}
