# Copie para .env se quiser sobrescrever padrões locais.
# Nenhum destes valores vai para o frontend — são lidos apenas no servidor.

PORT=3001

# iFood (API oficial de merchant + order events)
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_MERCHANT_ID=
IFOOD_WEBHOOK_SECRET=

# 99Food
NNFOOD_API_KEY=
NNFOOD_STORE_ID=
NNFOOD_WEBHOOK_SECRET=

# WhatsApp Business API (Cloud API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Gateway de pagamento — InfinitePay (Pix e cartão no checkout seguro deles)
# A InfiniteTag da loja é configurada pelo admin em Configurações → Pagamentos.
# Opcional: URL pública do sistema (para webhook e retorno do pagamento)
APP_BASE_URL=
PAYMENT_PROVIDER=infinitepay
